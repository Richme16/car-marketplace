# Copy this file to .env and fill in your real values.
# .env is git-ignored, so your real credentials never get pushed to GitHub.

# Your MongoDB Atlas connection string (from Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/motorline

# Port the backend server runs on
PORT=5000

# Cloudinary credentials (for uploading car photos) — from your Cloudinary Dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

